{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "skipLibCheck": true,
        "noEmit": true, // tsx runs the code; tsc only type-checks
        "types": ["node"]
    },
    "include": ["src", "tests"]
}
